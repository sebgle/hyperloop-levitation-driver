			(title_block
				(title "Levitation Coil Drive — Power Channel")
				(company "Guadaloop — Power Electronics Subsystem")
				(rev "0")
				(date "2026-08-13")
				(source "power_channel.kicad_sch")
				(comment
					(number "1")
					(value "Full H-bridge, bidirectional coil drive. 60 V bus · 30 A design · ±45 A trip.")
				)
				(comment
					(number "2")
					(value "Instantiated twice. Rails on AUX_RAILS, connectors + buffers on IO_PROTECT, bulk caps on BUS.")
				)
				(comment
					(number "3")
					(value "PROVISIONAL — coil L, k and R are unmeasured. See assumption register on this sheet.")
				)
				(comment
					(number "4")
