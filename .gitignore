# KiCad local / generated
*.kicad_prl
~*.lck
*-backups/
_autosave-*
fp-info-cache
*.bak
# numbered backups: every pour tool writes .bak1, .bak2, ... and '*.bak'
# does not match those. Three of them nearly went into the repo.
*.bak[0-9]*
*-bak
*.kicad_sch-bak
*.kicad_pcb-bak

# editor local history
.history/

# parked stale copies, kept on disk but not in the repo
_old/

# staged for manual deletion (agent cannot rm on this mount)
_to_delete/

# transfer artifact, regenerate with: git bundle create ../final_lev.bundle --all
final_lev.bundle

# python bytecode
__pycache__/
*.pyc

# working documents and generated files: kept on disk, out of the repo
HANDOFF.md
working/
_libcheck/
drc_report.rpt
final_lev_rev0.net
docs/_review_packet.txt
docs/_snapshot_*.net
